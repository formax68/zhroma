{
  "manifest_version": 3,
  "name": "Zhroma",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/neutral.png" }
  },
  "icons": { "32": "icons/neutral.png" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://*.zendesk.com/agent/*"],
    "js": ["content.js"],
    "css": ["zhroma.css"],
    "run_at": "document_idle",
    "world": "ISOLATED",
    "all_frames": false
  }]
}
